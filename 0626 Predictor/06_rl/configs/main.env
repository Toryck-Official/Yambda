# Independent RL mainline config for /root/autodl-tmp/0626/0626 Predictor.
# The shell scripts in 06_rl/scripts source this file. Keep defaults local to
# this project so the pipeline does not silently depend on 0408Yambda/Regret.

export REGRET_ROOT="${REGRET_ROOT:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PREDICTOR_PROJECT_ROOT="${PREDICTOR_PROJECT_ROOT:-$(cd "${REGRET_ROOT}/.." && pwd)}"

export MAIN_ID="${MAIN_ID:-main_v1}"

# Raw data and local processed mappings.
export MULTI_EVENT_PARQUET="${MULTI_EVENT_PARQUET:-/root/autodl-tmp/0330Yambda/data/sequential-50m/multi_event.parquet}"
export LOCAL_DATA_ROOT="${LOCAL_DATA_ROOT:-${PREDICTOR_PROJECT_ROOT}/01_data/processed}"
export LOCAL_MAPPING_ROOT="${LOCAL_MAPPING_ROOT:-${LOCAL_DATA_ROOT}/raw_rqkmeans}"
export ORIG2DENSE_NPY="${ORIG2DENSE_NPY:-${LOCAL_MAPPING_ROOT}/orig2dense_item_id.npy}"
export DENSE_ITEM_FEATURES_NPY="${DENSE_ITEM_FEATURES_NPY:-${LOCAL_MAPPING_ROOT}/dense_item_features.npy}"
export DENSE_ITEM2SID_NPY="${DENSE_ITEM2SID_NPY:-${LOCAL_MAPPING_ROOT}/dense_item2sid.npy}"

# Local transition data. Generate/copy it with 01_data/prepare_formal_data.sh.
export TRANSITION_ROOT="${TRANSITION_ROOT:-${LOCAL_DATA_ROOT}/regret_current_data}"

# RL artifacts stay under 06_rl/artifacts to avoid mixing them with predictor-only artifacts.
export SIM_OUT_DIR="${SIM_OUT_DIR:-${REGRET_ROOT}/artifacts/user_response/base_v1_sim}"
export SIMULATOR_CHECKPOINT="${SIMULATOR_CHECKPOINT:-${SIM_OUT_DIR}/regret_user_response.pt}"
export POLICY_ACTOR="${POLICY_ACTOR:-${REGRET_ROOT}/artifacts/current/policy_actor}"
export POLICY_CRITIC="${POLICY_CRITIC:-${REGRET_ROOT}/artifacts/current/policy_critic}"
export POLICY_META="${POLICY_META:-${REGRET_ROOT}/artifacts/current/policy_meta.json}"

export DATA_OUT_ROOT="${DATA_OUT_ROOT:-${REGRET_ROOT}/artifacts/transitions/main_v1_data}"
export SIM_TRAIN_OUT_DIR="${SIM_TRAIN_OUT_DIR:-${REGRET_ROOT}/artifacts/user_response/main_v1_simulator}"
export ACTOR_INIT_CHECKPOINT="${ACTOR_INIT_CHECKPOINT:-${REGRET_ROOT}/artifacts/init/regret_sid_session_run_v2_actor}"
export POLICY_SAVE_PREFIX="${POLICY_SAVE_PREFIX:-${REGRET_ROOT}/artifacts/models/policy_hsac_main}"
export POLICY_SAVE_META="${POLICY_SAVE_META:-${POLICY_SAVE_PREFIX}.meta.json}"

# Data splitting: 1 hour session gap; aggregate consecutive same-item events into one RL step.
export HISTORY_LEN="${HISTORY_LEN:-50}"
export SESSION_GAP_SECONDS="${SESSION_GAP_SECONDS:-3600}"
export MAX_SESSION_SPAN_SECONDS="${MAX_SESSION_SPAN_SECONDS:-21600}"
export MAX_RUN_EVENTS="${MAX_RUN_EVENTS:-100}"
export REPLAY_EVAL_STEPS="${REPLAY_EVAL_STEPS:-50}"
export TIMESTAMP_UNIT_SECONDS="${TIMESTAMP_UNIT_SECONDS:-5.0}"
export ANCHOR_POLICY="${ANCHOR_POLICY:-first_visible}"
export SHARD_ROWS="${SHARD_ROWS:-50000}"
export MAX_USERS="${MAX_USERS:-0}"
export REWARD_VERSION="${REWARD_VERSION:-v2}"

# Regret memory: mainline stores explicit negative feedback only.
export PRECOMPUTE_REGRET_MEMORY="${PRECOMPUTE_REGRET_MEMORY:-1}"
export REGRET_MEMORY_SIZE="${REGRET_MEMORY_SIZE:-20}"
export REGRET_MEMORY_GAMMA="${REGRET_MEMORY_GAMMA:-0.9}"
export REGRET_MEMORY_SCOPE="${REGRET_MEMORY_SCOPE:-explicit_negative}"
export REGRET_MEMORY_DELTA_MODE="${REGRET_MEMORY_DELTA_MODE:-time_hour}"
export REGRET_MEMORY_MIN_PHI="${REGRET_MEMORY_MIN_PHI:-0.000001}"

# Simulator.
export SIM_MAX_TRAIN_ROWS="${SIM_MAX_TRAIN_ROWS:-1000000}"
export SIM_MAX_VAL_ROWS="${SIM_MAX_VAL_ROWS:-10000}"
export SIM_MAX_TEST_ROWS="${SIM_MAX_TEST_ROWS:-10000}"
export SIM_EPOCHS="${SIM_EPOCHS:-3}"
export SIM_BATCH_SIZE="${SIM_BATCH_SIZE:-256}"
export SIM_READ_BATCH_SIZE="${SIM_READ_BATCH_SIZE:-2048}"
export SIM_LR="${SIM_LR:-0.0001}"

# HSAC policy training.
export HSAC_EPISODES="${HSAC_EPISODES:-100000}"
export HSAC_EPOCHS="${HSAC_EPOCHS:-1}"
export HSAC_BATCH_SIZE="${HSAC_BATCH_SIZE:-16}"
export HSAC_READ_BATCH_SIZE="${HSAC_READ_BATCH_SIZE:-512}"
export HSAC_SAMPLE_ACROSS_FILES="${HSAC_SAMPLE_ACROSS_FILES:-1}"
export HSAC_SHUFFLE_BUFFER_SIZE="${HSAC_SHUFFLE_BUFFER_SIZE:-0}"
export HSAC_MAX_STEPS="${HSAC_MAX_STEPS:-20}"
export HSAC_DECODE_TOP_K="${HSAC_DECODE_TOP_K:-4}"
export HSAC_GAMMA="${HSAC_GAMMA:-0.9}"
export HSAC_ACTOR_LR="${HSAC_ACTOR_LR:-0.00001}"
export HSAC_CRITIC_LR="${HSAC_CRITIC_LR:-0.0003}"
export HSAC_TARGET_TAU="${HSAC_TARGET_TAU:-0.05}"
export HSAC_ENTROPY_WEIGHT="${HSAC_ENTROPY_WEIGHT:-0.001}"
export HSAC_CRITIC_TYPE="${HSAC_CRITIC_TYPE:-action_q}"
# Optional HSRL-style reward-gated offline action supervision. Keep it off by
# default so simulator-rollout-only runs remain reproducible.
export HSAC_OFFLINE_AUX_WEIGHT="${HSAC_OFFLINE_AUX_WEIGHT:-0.0}"
export HSAC_OFFLINE_AUX_REWARD_THRESHOLD="${HSAC_OFFLINE_AUX_REWARD_THRESHOLD:-0.0}"
export HSAC_OFFLINE_AUX_TEMPERATURE="${HSAC_OFFLINE_AUX_TEMPERATURE:-0.5}"
export HSAC_OFFLINE_AUX_BC_WEIGHT="${HSAC_OFFLINE_AUX_BC_WEIGHT:-1.0}"
export HSAC_OFFLINE_AUX_AVOID_WEIGHT="${HSAC_OFFLINE_AUX_AVOID_WEIGHT:-1.0}"
export HSAC_OFFLINE_AUX_ENTROPY_WEIGHT="${HSAC_OFFLINE_AUX_ENTROPY_WEIGHT:-0.0}"
export USE_FUTURE_PREDICTOR="${USE_FUTURE_PREDICTOR:-0}"
export PREDICTOR_CHECKPOINT="${PREDICTOR_CHECKPOINT:-${PREDICTOR_PROJECT_ROOT}/artifacts/predictor_actionfix_1m/future_predictor.pt}"
export PREDICTOR_BETA="${PREDICTOR_BETA:-0.10}"
export PREDICTOR_REGRET_ETA="${PREDICTOR_REGRET_ETA:-1.0}"
export PREDICTOR_CANDIDATE_K="${PREDICTOR_CANDIDATE_K:-32}"
export PREDICTOR_SCORE_MODE="${PREDICTOR_SCORE_MODE:-future_return_minus_regret}"
export PREDICTOR_SCORE_NORM="${PREDICTOR_SCORE_NORM:-zscore}"
export CACHE_ITEM_FEATURES_ON_GPU="${CACHE_ITEM_FEATURES_ON_GPU:-0}"
export USE_MODEL_BASED_PREDICTOR="${USE_MODEL_BASED_PREDICTOR:-0}"
export FUTURE_VALUE_CHECKPOINT="${FUTURE_VALUE_CHECKPOINT:-${PREDICTOR_PROJECT_ROOT}/artifacts/value/future_value.pt}"
export MODEL_PREDICTOR_CHECKPOINT="${MODEL_PREDICTOR_CHECKPOINT:-${PREDICTOR_CHECKPOINT}}"
export MODEL_Q_WEIGHT="${MODEL_Q_WEIGHT:-0.05}"
export MODEL_Q_GAMMA="${MODEL_Q_GAMMA:--1.0}"
export MODEL_Q_CLIP="${MODEL_Q_CLIP:-0.0}"
export MODEL_Q_MODE="${MODEL_Q_MODE:-critic_target}"
export STRUCTURED_SIMULATOR_RESPONSE="${STRUCTURED_SIMULATOR_RESPONSE:-1}"
export SIMULATOR_NEGATIVE_PROB_SCALE="${SIMULATOR_NEGATIVE_PROB_SCALE:-1.0}"
export FAILURE_SIGNAL_SCOPE="${FAILURE_SIGNAL_SCOPE:-explicit_negative}"
export HSAC_NEGATIVE_PATIENCE="${HSAC_NEGATIVE_PATIENCE:-3}"
export HSAC_REWARD_DONE_THRESHOLD="${HSAC_REWARD_DONE_THRESHOLD:-}"
export MEMORY_SIGNAL_SCOPE="${MEMORY_SIGNAL_SCOPE:-explicit_negative}"
export TRAIN_USE_RAPI="${TRAIN_USE_RAPI:-1}"
export HSAC_SARA_ETA="${HSAC_SARA_ETA:-0.10}"
export HSAC_BASE_REWARD_MODE="${HSAC_BASE_REWARD_MODE:-paper}"
export RRCA_APPLY_TO="${RRCA_APPLY_TO:-effective_reward}"
export RRCA_SIGNAL_SCOPE="${RRCA_SIGNAL_SCOPE:-revision_only}"
export RRCA_CALLBACK_TARGET="${RRCA_CALLBACK_TARGET:-current}"
export GATE_REVISION_BY_HISTORY="${GATE_REVISION_BY_HISTORY:-1}"
export REWARD_W_LISTEN="${REWARD_W_LISTEN:-1.0}"
export REWARD_W_LIKE="${REWARD_W_LIKE:-1.0}"
export REWARD_W_DISLIKE="${REWARD_W_DISLIKE:-1.0}"
export RRCA_UNLIKE_WEIGHT="${RRCA_UNLIKE_WEIGHT:-1.0}"
export RRCA_UNDISLIKE_WEIGHT="${RRCA_UNDISLIKE_WEIGHT:-1.0}"
export LEARN_REWARD_WEIGHTS="${LEARN_REWARD_WEIGHTS:-0}"
export LEARN_REWARD_INIT="${LEARN_REWARD_INIT:-0.6}"
export REWARD_WEIGHT_LR="${REWARD_WEIGHT_LR:-0.001}"
export REWARD_WEIGHT_LOSS_WEIGHT="${REWARD_WEIGHT_LOSS_WEIGHT:-0.1}"

# Evaluation.
export ROLLOUT_EPISODES="${ROLLOUT_EPISODES:-1000}"
export ROLLOUT_MAX_STEPS="${ROLLOUT_MAX_STEPS:-20}"
export ROLLOUT_DECODE_TOP_K="${ROLLOUT_DECODE_TOP_K:-8}"
export ROLLOUT_READ_BATCH_SIZE="${ROLLOUT_READ_BATCH_SIZE:-2048}"
export ROLLOUT_BATCH_SIZE="${ROLLOUT_BATCH_SIZE:-64}"
# Evaluation stopping rule. By default this matches HSAC training: only explicit
# dislike / valid unlike are treated as negative-stop signals.
export ROLLOUT_FAILURE_SIGNAL_SCOPE="${ROLLOUT_FAILURE_SIGNAL_SCOPE:-explicit_negative}"
export ROLLOUT_NEGATIVE_PATIENCE="${ROLLOUT_NEGATIVE_PATIENCE:-3}"
export ROLLOUT_REWARD_DONE_THRESHOLD="${ROLLOUT_REWARD_DONE_THRESHOLD:-}"
export SARA_ETA="${SARA_ETA:-0.10}"
export ETA_LIST="${ETA_LIST:-0.05 0.10 0.20 0.30 0.50}"
