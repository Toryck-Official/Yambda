#!/usr/bin/env bash
# Shared baseline-comparison configuration.

export BASELINE_DIR="${BASELINE_DIR:-$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)}"
export PROJECT_ROOT="${PROJECT_ROOT:-$(cd "${BASELINE_DIR}/.." && pwd)}"
export WORKSPACE_ROOT="${WORKSPACE_ROOT:-$(cd "${PROJECT_ROOT}/.." && pwd)}"

export DATA_DIR="${DATA_DIR:-${PROJECT_ROOT}/01_data/processed/predictor_seq_data}"
export TRANSITION_ROOT="${TRANSITION_ROOT:-${PROJECT_ROOT}/01_data/processed/regret_current_data}"
export EMBED_STORE="${EMBED_STORE:-${PROJECT_ROOT}/01_data/processed/raw_rqkmeans}"
export ITEM_FEATURES_NPY="${ITEM_FEATURES_NPY:-${EMBED_STORE}/dense_item_features.npy}"
export DENSE_ITEM2SID_NPY="${DENSE_ITEM2SID_NPY:-${EMBED_STORE}/dense_item2sid.npy}"
export DENSE2ORIG_NPY="${DENSE2ORIG_NPY:-${EMBED_STORE}/dense2orig_item_id.npy}"

export BASELINE_ARTIFACT_ROOT="${BASELINE_ARTIFACT_ROOT:-${BASELINE_DIR}/artifacts}"
export BASELINE_LOG_DIR="${BASELINE_LOG_DIR:-${BASELINE_ARTIFACT_ROOT}/logs}"
export BASELINE_EVAL_DIR="${BASELINE_EVAL_DIR:-${BASELINE_ARTIFACT_ROOT}/evals}"

export DEVICE="${DEVICE:-cuda}"
export SEED="${SEED:-2026}"
export BATCH_SIZE="${BATCH_SIZE:-256}"
export EPOCHS="${EPOCHS:-1}"
export MAX_TRAIN_ROWS="${MAX_TRAIN_ROWS:-1000000}"
export MAX_VAL_ROWS="${MAX_VAL_ROWS:-100000}"

export D_MODEL="${D_MODEL:-128}"
export N_LAYER="${N_LAYER:-2}"
export N_HEAD="${N_HEAD:-4}"
export DROPOUT="${DROPOUT:-0.1}"
export STATE_POOLING="${STATE_POOLING:-last_mean}"
export SID_LEVELS="${SID_LEVELS:-4}"
export SID_VOCAB_SIZE="${SID_VOCAB_SIZE:-256}"

export CANDIDATE_CE_WEIGHT="${CANDIDATE_CE_WEIGHT:-1.0}"
export CANDIDATE_CE_K="${CANDIDATE_CE_K:-32}"
export CANDIDATE_CE_TEMPERATURE="${CANDIDATE_CE_TEMPERATURE:-1.0}"
export CANDIDATE_NEGATIVE_MODE="${CANDIDATE_NEGATIVE_MODE:-semantic_hard}"
export CANDIDATE_POOL_K="${CANDIDATE_POOL_K:-128}"
export HARD_PREFIX_LEVELS="${HARD_PREFIX_LEVELS:-3,2,1}"

export EVAL_SPLIT="${EVAL_SPLIT:-test}"
export EVAL_MAX_ROWS="${EVAL_MAX_ROWS:-50000}"
export EVAL_BATCH_SIZE="${EVAL_BATCH_SIZE:-256}"
export EVAL_CANDIDATE_K="${EVAL_CANDIDATE_K:-100}"
export EVAL_SEMANTIC_PREFIX="${EVAL_SEMANTIC_PREFIX:-2}"
export EVAL_K_LIST="${EVAL_K_LIST:-1,5,10,20}"

export ROLLOUT_SPLIT="${ROLLOUT_SPLIT:-test}"
export ROLLOUT_EPISODES="${ROLLOUT_EPISODES:-200}"
export ROLLOUT_BATCH_SIZE="${ROLLOUT_BATCH_SIZE:-256}"
export ROLLOUT_READ_BATCH_SIZE="${ROLLOUT_READ_BATCH_SIZE:-2048}"
export ROLLOUT_MAX_STEPS="${ROLLOUT_MAX_STEPS:-20}"
export ROLLOUT_DECODE_TOP_K="${ROLLOUT_DECODE_TOP_K:-8}"
export ROLLOUT_ACTION_MODE="${ROLLOUT_ACTION_MODE:-sample}"
export ROLLOUT_ACTION_TEMPERATURE="${ROLLOUT_ACTION_TEMPERATURE:-1.0}"
export ROLLOUT_EVAL_REWARD_MODE="${ROLLOUT_EVAL_REWARD_MODE:-paper_effective}"
export ROLLOUT_FAILURE_SIGNAL_SCOPE="${ROLLOUT_FAILURE_SIGNAL_SCOPE:-all_failed}"
export ROLLOUT_NEGATIVE_PATIENCE="${ROLLOUT_NEGATIVE_PATIENCE:-3}"
export ROLLOUT_REWARD_DONE_THRESHOLD="${ROLLOUT_REWARD_DONE_THRESHOLD:-}"
export ROLLOUT_SAMPLE_RESPONSE="${ROLLOUT_SAMPLE_RESPONSE:-1}"
export ROLLOUT_STRUCTURED_SIMULATOR_RESPONSE="${ROLLOUT_STRUCTURED_SIMULATOR_RESPONSE:-1}"
export ROLLOUT_SIMULATOR_NEGATIVE_PROB_SCALE="${ROLLOUT_SIMULATOR_NEGATIVE_PROB_SCALE:-1.0}"
export ROLLOUT_SIMULATOR_CHECKPOINT="${ROLLOUT_SIMULATOR_CHECKPOINT:-${PROJECT_ROOT}/06_rl/artifacts/user_response/base_v1_sim/regret_user_response.pt}"
export BASELINE_ROLLOUT_MODELS="${BASELINE_ROLLOUT_MODELS:-sasrec_sid hpn_sid hsrl_offline}"

export SASREC_OUT_DIR="${SASREC_OUT_DIR:-${BASELINE_ARTIFACT_ROOT}/sasrec_sid}"
export HPN_OUT_DIR="${HPN_OUT_DIR:-${BASELINE_ARTIFACT_ROOT}/hpn_sid}"
export HSRL_OUT_DIR="${HSRL_OUT_DIR:-${BASELINE_ARTIFACT_ROOT}/hsrl_offline}"

export SASREC_TRAIN_ENTRY="${SASREC_TRAIN_ENTRY:-${BASELINE_DIR}/train_sasrec_sid.py}"
export HPN_TRAIN_ENTRY="${HPN_TRAIN_ENTRY:-${BASELINE_DIR}/train_hpn_sid.py}"

export HSRL_PROJECT_ROOT="${HSRL_PROJECT_ROOT:-${WORKSPACE_ROOT}/HSRL}"
export HSRL_ROOT="${HSRL_ROOT:-${HSRL_PROJECT_ROOT}/hsrl_core}"
export HSRL_BOOTSTRAP_ROOT="${HSRL_BOOTSTRAP_ROOT:-${WORKSPACE_ROOT}}"
export HSRL_HPN_CHECKPOINT="${HSRL_HPN_CHECKPOINT:-${PROJECT_ROOT}/06_rl/artifacts/init/regret_sid_session_run_v2_actor}"
export HSRL_SAVE_PREFIX="${HSRL_SAVE_PREFIX:-${HSRL_OUT_DIR}/hsrl_offline}"
export HSRL_TRAIN_ENTRY="${HSRL_TRAIN_ENTRY:-${BASELINE_DIR}/hsrl_upstream/06_train_yambda_sid.py}"
